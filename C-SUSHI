import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n1=sc.nextInt();
       int n2=sc.nextInt();
       int[] arr=new int[n1];
       int[] arr2=new int[n2];
       for(int i=0;i<n1;i++){
           arr[i]=sc.nextInt();
       }
       for(int i=0;i<n2;i++){
           arr2[i]=sc.nextInt();
       }
       Arrays.sort(arr);
       Arrays.sort(arr2);
       int i=n1-1;
       int j=n2-1;
       int c=0;
       while(i>=0 && j>=0){
           if(arr2[j]<=arr[i]*2){
               c++;
               i--;
               j--;
           }
           else{
               j--;
           }
       }
       System.out.println(c);
    }
}
